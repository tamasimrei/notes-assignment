# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# The defaults below work out of the box with `docker compose up -d`.
# See .env.local.sample for the values you may want to override locally.
# https://symfony.com/doc/current/configuration.html#configuring-environment-variables-in-env-files

###> symfony/framework-bundle ###
APP_ENV=dev
# The dev secret lives in .env.dev and the test secret in .env.test; set a real one for prod.
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Points at the `db` service from docker-compose.yml.
# In the test environment Doctrine appends "_test" to the database name.
DATABASE_URL="mysql://root:Pas_W0rd@db:3306/tm-notes?serverVersion=10.8.3-MariaDB"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
# Regular expression matched against the Origin header of API requests.
CORS_ALLOW_ORIGIN=localhost
###< nelmio/cors-bundle ###
