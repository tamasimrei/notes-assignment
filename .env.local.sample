# Sample local overrides. The committed .env already makes the project work with
# Docker Compose, so this file is optional:
#
#   cp .env.local.sample .env.local
#
# then uncomment and change only what differs on your machine.
# .env.local is ignored by git, so it is the place for real secrets.

# Run the app in another environment (dev, test or prod).
#APP_ENV=prod

# Required when APP_ENV=prod: a long random string, for example from `openssl rand -hex 16`.
#APP_SECRET=change-me

# Database connection, if you don't use the `db` service from docker-compose.yml.
#DATABASE_URL="mysql://user:password@127.0.0.1:3306/tm-notes?serverVersion=10.8.3-MariaDB"

# Regular expression for origins allowed to call the API (the frontend's origin).
#CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Base URL used when generating URLs outside of HTTP requests, such as in console commands.
#DEFAULT_URI=https://notes.example.com
